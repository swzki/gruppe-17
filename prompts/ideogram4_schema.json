{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "ideogram4",
  "title": "Ideogram-4 JSON-Prompt (Filmplakat, Hochformat)",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "style", "palette", "elements"],
  "properties": {
    "type": {
      "type": "string",
      "const": "poster"
    },
    "style": {
      "type": "string",
      "minLength": 10,
      "description": "Gesamtstil des Plakats als ein englischer Prompt-String"
    },
    "palette": {
      "type": "array",
      "minItems": 3,
      "maxItems": 8,
      "items": { "type": "string" },
      "description": "Farbwelt des Plakats"
    },
    "elements": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "description"],
        "properties": {
          "kind": {
            "type": "string",
            "enum": ["background", "figure", "prop", "text"]
          },
          "description": {
            "type": "string",
            "minLength": 10,
            "description": "Aussehen und Platzierung des Elements, englisch"
          },
          "content": {
            "type": "string",
            "description": "Nur bei kind=text: der wörtlich darzustellende Text"
          },
          "font": {
            "type": "string",
            "description": "Nur bei kind=text: Schiftart, z.B. bold condensed sans"
          },
          "bbox": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": { "type": "integer", "minimum": 0, "maximum": 1000 },
            "description": "Nur bei kind=text: [x1, y1, x2, y2] in/promill 0-1000"
          }
        },
        "allOf": [
          {
            "if": { "properties": { "kind": { "const": "text" } } },
            "then": { "required": ["kind", "description", "content", "bbox"] }
          }
        ]
      }
    }
  }
}
